<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base style for rounded buttons -->
    <style name="ShapeAppearance.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <!-- Dashboard button – solid fill, white text in light mode -->
    <style name="DashboardButton" parent="Widget.Material3.Button">
        <item name="android:textColor">?attr/colorOnPrimary</item>
    </style>

    <!-- Main app theme -->
    <style name="Theme.BudgetMilestoneTracker" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@android:color/white</item>

        <!-- Secondary / accent -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@android:color/black</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@color/purple_700</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Rounded corners for all MaterialButtons -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Small</item>
    </style>
</resources>