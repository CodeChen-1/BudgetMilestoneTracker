<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/goal_label">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etGoalLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/target_amount">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etTargetAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal" />
    </com.google.android.material.textfield.TextInputLayout>

    <Button
        android:id="@+id/btnPickDeadline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/select_deadline" />

    <CheckBox
        android:id="@+id/checkRoundUp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/round_up_label" />
</LinearLayout>