<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dashboard button – outlined, primary text in dark mode -->
    <style name="DashboardButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">?attr/colorPrimary</item>
        <item name="strokeWidth">2dp</item>
    </style>

    <style name="Theme.BudgetMilestoneTracker" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color (lighter for dark mode contrast) -->
        <item name="colorPrimary">@color/purple_200</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@android:color/black</item>

        <!-- Secondary / accent -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@android:color/black</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@color/purple_700</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Rounded corners for all MaterialButtons -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Small</item>
    </style>
</resources>